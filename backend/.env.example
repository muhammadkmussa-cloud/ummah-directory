# Application Settings
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=CHANGE_ME_GENERATE_A_SECURE_RANDOM_KEY_MIN_32_CHARS

# Database Configuration
DATABASE_URL=postgresql+asyncpg://ummah:ummah_dev_password@postgres:5432/ummah_directory_dev

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# JWT Authentication
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_SECURE_RANDOM_JWT_KEY_MIN_32_CHARS
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Settings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Email Configuration (Mailgun)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=noreply@example.com

# S3 Storage Configuration
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=umma-directory-uploads
S3_REGION=fsn1

# Stripe Payment Gateway
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# PayPal Payment Gateway
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox

# M-Pesa Payment Gateway
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_BUSINESS_SHORTCODE=174379
MPESA_CALLBACK_URL=https://your-domain.com/api/v1/payments/mpesa/callback
MPESA_ENVIRONMENT=sandbox
MPESA_WEBHOOK_SECRET=

# SMS Provider (log, twilio, africastalking)
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=

# Donation Settings
MIN_DONATION_AMOUNT=10.0
DONATION_CURRENCIES=KES,USD,EUR,GBP

# Monitoring & Error Tracking
SENTRY_DSN=

# Web Push Notifications (VAPID)
# Generate with: npx web-push generate-vapid-keys or py_vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT_EMAIL=

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Allowed Hosts (comma-separated, use * for development only)
ALLOWED_HOSTS=*

# Database Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true
